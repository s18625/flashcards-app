{
  "name": "flashcards-app",
  "private": true,
  "version": "1.0.0",
  "description": "Progresywna aplikacja webowa do nauki angielskich słówek za pomocą fiszek",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.1",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.5"
  }
}
